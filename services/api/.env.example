# ============================================================
#  AI 视频解说工作站 · 环境配置示例
#  复制为 .env 后按需修改；所有项都有默认值，可全部留空。
# ============================================================

# ---------- 数据与路径 ----------
# 数据目录（上传素材、工作文件、成片、数据库）
VC_DATA_DIR=
# FFmpeg / FFprobe 可执行文件路径（留空则从 PATH 查找）
VC_FFMPEG=ffmpeg
VC_FFPROBE=ffprobe

# ---------- 密钥加密主密钥 ----------
# 留空会自动在 data/master.key 生成一个随机主密钥。
# 注意：更换主密钥会导致已保存的 API Key 无法解密。
# VC_MASTER_KEY=please-change-me-to-a-long-random-string

# ---------- 平台托管 Key（模式 B） ----------
# 模式 A（用户自带 Key）无需配置任何内容。
# 设置下列环境变量后，平台可统一使用这些 Key，用户无需自行申请。
# VC_SERVER_KEY_GEMINI=
# VC_SERVER_KEY_OPENAI=
# VC_SERVER_KEY_QWEN=
# VC_SERVER_KEY_DOUBAO=
# VC_SERVER_KEY_SILICONFLOW=
# VC_SERVER_KEY_OLLAMA=
# VC_SERVER_KEY_OPENAI_TTS=
# VC_SERVER_KEY_AZURE_TTS=
# VC_SERVER_KEY_ELEVENLABS=

# ---------- 上传限制 ----------
# 单个视频最大体积（MB）
VC_MAX_UPLOAD_MB=4096

# ---------- 抽帧与镜头切分 ----------
# 兜底抽帧间隔（秒）
VC_FRAME_INTERVAL=2.0
# 全片最多抽取多少帧
VC_MAX_FRAMES_TOTAL=160
# 场景切换阈值（0-1，越小切分越细）
VC_SCENE_THRESHOLD=0.28

# ---------- 网络超时 ----------
VC_CONNECT_TIMEOUT=30
VC_READ_TIMEOUT=600
VC_UPLOAD_TIMEOUT=1800
VC_MAX_RETRIES=3
VC_RETRY_BACKOFF=2

# ---------- 前端构建产物目录 ----------
# VC_FRONTEND_DIST=F:/视频解说/frontend/dist

# ---------- 访问控制（部署到多人可访问的环境时必填） ----------
# 设置后，除 /api/ping 与 /api/health 外所有接口都需要口令。
# 口令可通过三种方式携带：Authorization: Bearer <token> / X-Access-Token 头 / ?token= 查询参数。
# VC_ACCESS_TOKEN=请换成一段足够长的随机字符串

# ---------- CORS 白名单 ----------
# 留空表示允许任意来源；正式部署建议填具体域名，逗号分隔。
# VC_CORS_ORIGINS=https://your-domain.com

# ---------- 字幕字体 ----------
# Windows 默认微软雅黑；Linux 建议装 fonts-noto-cjk 并保持默认即可。
# VC_SUBTITLE_FONT=Noto Sans CJK SC
# VC_SUBTITLE_FONT_SIZE=20

# ---------- 密钥加密主密钥 ----------
# 留空会自动在 data/master.key 生成一个随机主密钥。
# 注意：更换主密钥会导致已保存的 API Key 无法解密。
# VC_MASTER_KEY=请换成一段长随机字符串

# ---------- 前端构建产物目录 ----------
# 留空则按 monorepo 约定位置查找 apps/web/dist。
# VC_FRONTEND_DIST=F:/视频解说/apps/web/dist

# ---------- 抽帧与镜头切分 ----------
# 每个镜头最多抽取多少帧
# VC_MAX_FRAMES_PER_SHOT=8
# 帧间差异超过该值判定为「快速运动」，触发补帧
# VC_MOTION_THRESHOLD=18.0

# ---------- 服务形态 ----------
# inline：任务在 API 进程内执行（桌面版 / 单机部署，默认）
# external：API 只入队，由 services/worker 独立进程执行（云端多 worker）
# VC_WORKER_MODE=inline
# Worker 轮询间隔与单次上限
# VC_WORKER_POLL_INTERVAL=2
# VC_WORKER_MAX_JOBS=0
# 云端数据库（留空则使用本地 SQLite）
# VC_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/videonarrator
# 生效的套餐（自建实例用）
# VC_TIER=self-hosted
# 套餐配置文件路径
# VC_TIERS_FILE=config/tiers.yaml

# ---------- 代理 ----------
# 模型 API 需要走代理时使用。留空则自动探测：
#   1) VC_PROXY
#   2) HTTP_PROXY / HTTPS_PROXY 环境变量
#   3) Windows「设置 → 代理」里的系统代理（自动发现）
# VC_PROXY=http://127.0.0.1:7890