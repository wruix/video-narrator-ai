# ============================================================
#  AI 视频解说工作站 · 环境配置示例
#  复制为 .env 后按需修改；所有项都有默认值，可全部留空。
# ============================================================

# ---------- 数据与路径 ----------
# 数据目录（上传素材、工作文件、成片、数据库）
VC_DATA_DIR=
# FFmpeg / FFprobe 可执行文件路径（留空则从 PATH 查找）
VC_FFMPEG=ffmpeg
VC_FFPROBE=ffprobe

# ---------- 密钥加密主密钥 ----------
# 留空会自动在 data/master.key 生成一个随机主密钥。
# 注意：更换主密钥会导致已保存的 API Key 无法解密。
# VC_MASTER_KEY=please-change-me-to-a-long-random-string

# ---------- 平台托管 Key（模式 B） ----------
# 模式 A（用户自带 Key）无需配置任何内容。
# 设置下列环境变量后，平台可统一使用这些 Key，用户无需自行申请。
# VC_SERVER_KEY_GEMINI=
# VC_SERVER_KEY_OPENAI=
# VC_SERVER_KEY_QWEN=
# VC_SERVER_KEY_DOUBAO=
# VC_SERVER_KEY_SILICONFLOW=
# VC_SERVER_KEY_OLLAMA=
# VC_SERVER_KEY_OPENAI_TTS=
# VC_SERVER_KEY_AZURE_TTS=
# VC_SERVER_KEY_ELEVENLABS=

# ---------- 上传限制 ----------
# 单个视频最大体积（MB）
VC_MAX_UPLOAD_MB=4096

# ---------- 抽帧与镜头切分 ----------
# 兜底抽帧间隔（秒）
VC_FRAME_INTERVAL=2.0
# 全片最多抽取多少帧
VC_MAX_FRAMES_TOTAL=160
# 场景切换阈值（0-1，越小切分越细）
VC_SCENE_THRESHOLD=0.28

# ---------- 网络超时 ----------
VC_CONNECT_TIMEOUT=30
VC_READ_TIMEOUT=600
VC_UPLOAD_TIMEOUT=1800
VC_MAX_RETRIES=3
VC_RETRY_BACKOFF=2

# ---------- 前端构建产物目录 ----------
# VC_FRONTEND_DIST=F:/视频解说/frontend/dist

# ---------- 访问控制（部署到多人可访问的环境时必填） ----------
# 设置后，除 /api/ping 与 /api/health 外所有接口都需要口令。
# 口令可通过三种方式携带：Authorization: Bearer <token> / X-Access-Token 头 / ?token= 查询参数。
# VC_ACCESS_TOKEN=请换成一段足够长的随机字符串

# ---------- CORS 白名单 ----------
# 留空表示允许任意来源；正式部署建议填具体域名，逗号分隔。
# VC_CORS_ORIGINS=https://your-domain.com

# ---------- 字幕字体 ----------
# Windows 默认微软雅黑；Linux 建议装 fonts-noto-cjk 并保持默认即可。
# VC_SUBTITLE_FONT=Noto Sans CJK SC
# VC_SUBTITLE_FONT_SIZE=20
