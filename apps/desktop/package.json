{
  "name": "@vns/desktop",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "VideoNarrator AI desktop shell",
  "author": {
    "name": "VideoNarrator AI Contributors",
    "email": "wruix@users.noreply.github.com"
  },
  "homepage": "https://github.com/wruix/video-narrator-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/wruix/video-narrator-ai.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  }
}
